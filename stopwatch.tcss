CustomStopwatchWidget {
    layout: horizontal;
    background: $boost;
    margin: 2;
    padding: 2;
    height: 50%;
    width: 100%;
}

#startButton{
    align: left middle;
}

#stopButton{
    align: left middle;
    display: none;
}

#resetButton{
    align: right middle;
}

StopwatchTime{
    content-align: center middle;
    height: 100%;
    width: 100%;
}